    {
      "parameters": {
        "jsCode": "\nconst resultado = [];\n\nfor (const item of $input.all()) {\n  const dados = item.json;\n\n  const moedaBase = dados.base;\n  const taxas = dados.rates;\n\n  for (const [data, moedas] of Object.entries(taxas)) {\n    for (const [moedaDestino, taxa] of Object.entries(moedas)) {\n      resultado.push({\n        json: {\n          moeda_base: moedaBase,\n          moeda_destino: moedaDestino,\n          taxa: taxa,\n          data_cotacao: data\n        }\n      });\n    }\n  }\n}\n\nreturn resultado;\n"
      },
