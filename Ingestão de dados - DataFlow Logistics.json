    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO fretes_convertidos (\n    rota_codigo, cliente_nome, moeda_cliente,\n    valor_frete_usd, taxa_aplicada, valor_frete_local, data_cotacao, calculado_em\n)\nSELECT\n  r.codigo,\n  c.nome,\n  c.moeda_principal,\n  r.valor_frete_usd,\n  (SELECT taxa FROM cotacoes WHERE moeda_base = 'USD' AND moeda_destino = c.moeda_principal ORDER BY data_cotacao DESC LIMIT 1),\n  ROUND(r.valor_frete_usd * (SELECT taxa FROM cotacoes WHERE moeda_base = 'USD' AND moeda_destino = c.moeda_principal ORDER BY data_cotacao DESC LIMIT 1), 2),\n  (SELECT data_cotacao FROM cotacoes WHERE moeda_base = 'USD' AND moeda_destino = c.moeda_principal ORDER BY data_cotacao DESC LIMIT 1),\n  NOW()\nFROM rotas r\nJOIN clientes c ON c.id = r.cliente_id\nON CONFLICT (rota_codigo, data_cotacao)\nDO UPDATE SET\n    taxa_aplicada = EXCLUDED.taxa_aplicada,\n    valor_frete_local = EXCLUDED.valor_frete_local,\n    calculado_em = NOW();",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1120,
        464
      ],
      "id": "ceae7c9c-be8e-47d8-baec-3df05f836851",
      "name": "Consolidar Fretes (Gold)",
      "credentials": {
        "postgres": {
          "id": "gwvVXi2DEp59PCZg",
          "name": "DataFlow"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  fc.rota_codigo,\n  fc.cliente_nome,\n  fc.moeda_cliente,\n  fc.valor_frete_local,\n  fc.taxa_aplicada AS taxa_hoje,\n  (SELECT taxa FROM cotacoes WHERE moeda_base = 'USD' AND moeda_destino = fc.moeda_cliente AND \ndata_cotacao <= CURRENT_DATE - INTERVAL '6 days' ORDER BY data_cotacao DESC LIMIT 1) AS taxa_7d,\n  ROUND(\n    ((fc.taxa_aplicada - (SELECT taxa FROM cotacoes WHERE moeda_base = 'USD' AND moeda_destino = fc.\nmoeda_cliente AND data_cotacao <= CURRENT_DATE - INTERVAL '6 days' ORDER BY data_cotacao DESC LIMIT 1))\n    / (SELECT taxa FROM cotacoes WHERE moeda_base = 'USD' AND moeda_destino = fc.moeda_cliente AND\ndata_cotacao <= CURRENT_DATE - INTERVAL '6 days' ORDER BY data_cotacao DESC LIMIT 1))\n  * 100, 2) AS variacao_pct\nFROM fretes_convertidos fc\nWHERE fc.calculado_em = (SELECT MAX(calculado_em) FROM fretes_convertidos)",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1344,
